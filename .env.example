# 이 파일을 .env.local로 복사해 값을 채웁니다. .env.local은 Git에 올라가지 않습니다.

# Supabase (공개용 Publishable key만 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 선택: 지원 폼 링크 (README Generator에서는 사용하지 않음)
NEXT_PUBLIC_APPLICATION_FORM_URL=

# AI - 서버에서만 사용합니다. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요(브라우저 노출 방지).
# anthropic 또는 openai(OpenAI 호환 chat completions)
AI_PROVIDER=
# 비우면 각 공급자의 기본 주소를 사용. 호환 서버/프록시를 쓸 때만 입력
AI_BASE_URL=
AI_API_KEY=
# 가벼운 작업용(fast) / 품질 우선 작업용(main) 모델명
AI_MODEL_FAST=
AI_MODEL_MAIN=
